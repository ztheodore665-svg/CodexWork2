digraph getWeekday {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.42", fontname="SimSun"];
  node [shape=box, style="rounded", fontname="SimSun", fontsize=10, margin="0.12,0.08"];
  edge [fontname="SimSun", fontsize=9, arrowsize=0.7];

  start [shape=oval, label="开始"];
  init [label="MonthDays = [31,28,31,30,31,30,31,31,30,31,30,31]"];
  leap [shape=diamond, label="((year%4==0) && (year%100!=0))\n|| year%400==0 ?"];
  feb [label="MonthDays[1] = 29"];
  neg [shape=diamond, label="year<0 || month<0 || day<0 ?"];
  ret0 [label="return 0"];
  maxyear [shape=diamond, label="year > 10000 ?"];
  ret1 [label="return -1"];
  maxmonth [shape=diamond, label="month > 12 ?"];
  ret2 [label="return -2"];
  daycheck [shape=diamond, label="day > MonthDays[month-1] ?\n(month=0时辅助函数抛出IndexError)"];
  ret3 [label="return -3"];
  initdays [label="totalDays = 0; i = 1"];
  yearloop [shape=diamond, label="i < year ?"];
  ileap [shape=diamond, label="((i%4==0) && (i%100!=0))\n|| i%400==0 ?"];
  plus366 [label="totalDays += 366"];
  plus365 [label="totalDays += 365"];
  inext [label="i += 1"];
  initmonth [label="j = 1"];
  monthloop [shape=diamond, label="j < month ?"];
  plusmonth [label="totalDays += MonthDays[j-1]"];
  jnext [label="j += 1"];
  addday [label="totalDays += day\ntempDay = totalDays % 7"];
  weekdayzero [shape=diamond, label="tempDay == 0 ?"];
  setseven [label="tempDay = 7"];
  ret [label="return tempDay"];
  end [shape=oval, label="结束"];
  error [shape=note, label="注：日历月份为1至12；\nmonth=0未被前置条件拦截"];

  start -> init -> leap;
  leap -> feb [label="是"];
  feb -> neg;
  leap -> neg [label="否"];
  neg -> ret0 [label="是"];
  neg -> maxyear [label="否"];
  maxyear -> ret1 [label="是"];
  maxyear -> maxmonth [label="否"];
  maxmonth -> ret2 [label="是"];
  maxmonth -> daycheck [label="否"];
  daycheck -> ret3 [label="是"];
  daycheck -> initdays [label="否"];
  initdays -> yearloop;
  yearloop -> ileap [label="是"];
  yearloop -> initmonth [label="否"];
  ileap -> plus366 [label="是"];
  ileap -> plus365 [label="否"];
  plus366 -> inext;
  plus365 -> inext;
  inext -> yearloop;
  initmonth -> monthloop;
  monthloop -> plusmonth [label="是"];
  monthloop -> addday [label="否"];
  plusmonth -> jnext -> monthloop;
  addday -> weekdayzero;
  weekdayzero -> setseven [label="是"];
  weekdayzero -> ret [label="否"];
  setseven -> ret -> end;
  ret0 -> end [style=dashed];
  ret1 -> end [style=dashed];
  ret2 -> end [style=dashed];
  ret3 -> end [style=dashed];
  daycheck -> error [style=dotted, arrowhead=none];
}
