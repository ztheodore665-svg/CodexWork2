# 复制为 .env.local 后填写。VITE_ 前缀的变量会被打进前端产物 —— 只放浏览器端公开的值。

# 高德地图 JS API Key（W6-2 地图页必需；不配则地图显示占位卡，其余功能不受影响）
# 申请：https://lbs.amap.com/ → 创建应用 → 添加 Web端(JS API) Key
# 注意：这个 key 会随产物分发，靠 referer 白名单保护，不要当机密；服务端调用的
#       AMAP_API_KEY（REST）另有其表，在仓库根目录 .env，不进前端。
VITE_AMAP_JS_KEY=
# 高德控制台的安全密钥（官方字段名 securityJsCode，可选；JS API 2.0 配套使用）
# 注意：产物里会写成 window._AMapSecurityConfig = { securityJsCode }，别写成 securityCode，
#       那个字段名高德不认，配了等于没配（合并加载器时修掉过一次，见 stage9 §6.1 坑 8）。
VITE_AMAP_SECURITY_CODE=

# 后端 API 基地址。留空 = 同域相对路径（生产由 Nginx 反代 /api）；
# 开发期 vite.config.ts 已把 /api 代理到 http://localhost:8000。
VITE_API_BASE=

# 轨迹回放开关：设为 1 才在行程卡片上显示回放入口；本功能尚未随主线验收，默认关闭。
VITE_TRAIL_REPLAY=0

# 阶段 11：主应用 iframe 嵌入的两个小应用地址（dev 默认值见 StudioEmbed.tsx）。
# 留空 = 用默认值 http://localhost:5174 / http://localhost:5175；
# 部署时改成小应用的真实 origin（postMessage 的 targetOrigin 取自这里的 origin）。
VITE_STUDIO_TRACK_URL=http://localhost:5174
VITE_STUDIO_SHARE_URL=http://localhost:5175
