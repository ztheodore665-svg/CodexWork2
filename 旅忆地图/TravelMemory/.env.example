# ---------- 基础（阶段 0 起）----------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel_memory
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_VERSION=bge-m3@v1
EMBEDDING_DIM=1024
LLM_API_KEY=
LLM_BASE_URL=
AGENT_RUNTIME=pipeline                  # pipeline | graph（阶段 4 切换）
LLM_DAILY_BUDGET_CENTS=2000             # 日成本硬上限，Redis 原子计数
LOG_LEVEL=INFO

# provider 开关：auto 表示「配了 Key 走真实服务，没配就降级为本地占位实现」
#  - mock LLM：本地规则作答（不能作为效果评估）
#  - hashing embedding：本地哈希向量（只认字面相似，不能作为检索质量结论）
LLM_PROVIDER=auto                       # auto | openai | mock
LLM_MODEL=deepseek-chat
EMBEDDING_PROVIDER=auto                 # auto | openai | hashing
EMBEDDING_BASE_URL=                     # 留空时复用 LLM_BASE_URL
EMBEDDING_API_KEY=                      # 留空时复用 LLM_API_KEY

# ---------- 离线批处理（阶段 1）----------
JOB_MAX_ATTEMPTS=3           # 单条任务最大重试次数（超过后需人工排查）
JOB_MAX_COST_CENTS=5000      # 单次跑批成本上限（分），到了就停，剩下的下次继续
VISION_PROVIDER=auto         # auto | openai | mock（mock = 本地规则生成，仅验证链路）
VISION_MODEL=qwen-vl-max
VISION_MODEL_VERSION=qwen-vl-max@v1    # 变更此值会触发 caption 全量重跑
VISION_BASE_URL=                       # 留空时复用 LLM_BASE_URL

# 检索与上下文
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.01                # 余弦相似度的绝对高度取决于 provider：真实 embedding 常年在
RETRIEVAL_USE_ANN=false                 # HNSW 近似检索。数据量过万之前保持 false：
                                        # 小库上图没建好，近似近邻严重偏离（实测纯向量 Recall@5
                                        # 从 0.6+ 掉到 0.0）。本项必须与 HNSW_ENABLED 同时为 true 才生效。
                                        # 0.2~0.9，哈希向量只有 0.05~0.13。设 0.30 在真实模型下会
                                        # 把证据全滤光 → 所有问题拒答。请按你自己的 embedding 分布调。
CONTEXT_MAX_CHARS=4000
DEMO_USER_NAME=我

# ⚠ 离线占位模式（hashing 向量）必须额外改这三处，否则会一直拒答 / 启动自检报错：
#   EMBEDDING_PROVIDER=hashing
#   EMBEDDING_MODEL=hashing
#   EMBEDDING_MODEL_VERSION=hashing-1024@v1   （1024 = EMBEDDING_DIM）
#   RETRIEVAL_MIN_SCORE=0.05                  （哈希向量相似度普遍只有 0.05~0.13）
# 该模式只能证明"链路通了"，检索质量必须配真实 embedding 后再评估。
# ---------- 阶段 3+ ----------
REDIS_URL=redis://localhost:6379/0
AMAP_API_KEY=
AMAP_JS_KEY=
RERANK_MODEL=bge-reranker-v2-m3         # 无 GPU 时改用 Qwen rerank API

# ---------- 阶段 4：Agent 编排 ----------
# AGENT_RUNTIME 见文件顶部（默认 pipeline；改成 graph 走 LangGraph）
# 融合策略：weighted = 归一化加权求和（阶段 2~3 行为）；rrf = 倒数排名融合（W4-3）
RETRIEVAL_FUSION=weighted
RETRIEVAL_RRF_K=60                      # RRF 平滑常数，60 是原论文与工业界常用值

# ---------- 阶段 4：Memory（W4-1）----------
MEMORY_ENABLED=true                     # 关闭后上下文里没有 [用户偏好]，行为退回阶段 3
MEMORY_HALF_LIFE_SHORT_TERM=1           # 短期（会话 / 当前行程）半衰期，天
MEMORY_HALF_LIFE_EPISODIC=30            # 情景（某次旅行摘要）半衰期，天
MEMORY_HALF_LIFE_SEMANTIC=90            # 语义（用户偏好）半衰期，天（设计文档 §7.5）
MEMORY_ARCHIVE_THRESHOLD=0.05           # 权重低于此值 → 归档（不物理删除）
MEMORY_MAX_ITEMS_PER_SECTION=5          # 每个区块最多注入几条
MEMORY_SUMMARIZE_EVERY=8                # 每多少轮写一次会话摘要

# ---------- 阶段 4：上下文压缩（W4-3）----------
CONTEXT_COMPRESS_ENABLED=true           # 压缩顺序：证据 > 历史对话 > 记忆

# ---------- 阶段 6+ ----------
# 必须显式写 http:// —— 不写协议时 boto3 / minio-py 默认走 HTTPS，
# 而本地 MinIO 是自签名证书，会直接报 SSL 验证失败。
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# ---------- 科研轨（阶段 7，全部默认关闭）----------
PRIVACY_ENABLED=false
SEMANTIC_ENABLED=false
ZK_ENABLED=false
CHAIN_ENABLED=false

PRIVACY_VERSION=privacy-2026.1
PRIVACY_DEFAULT_EPSILON=1.0             # km^-1
PRIVACY_DEFAULT_MECHANISM=geo_indistinguishability
PRIVACY_SEMANTIC_UMAX=0.3               # 语义感知扰动的效用损失上限
PRIVACY_K_ANONYMITY=5                   # 模式发布最小支持度

SEMANTIC_TAG_VERSION=sem-2026.1
SEMANTIC_MAX_SEQ_LEN=6                  # 语义序列截断长度，降低重识别风险
SEMANTIC_MIN_SCORE=4.0                  # 进入模式库的评分门槛

ZK_SCHEME=none                          # none | merkle_sig | groth16 | halo2
ZK_CIRCUIT_VERSION=route-v1
ZK_EXECUTOR=subprocess
ZK_TIMEOUT_SEC=30
CHAIN_BACKEND=local                     # local | ots | sepolia
CHAIN_RPC_URL=
CHAIN_CONTRACT_ADDR=
CHAIN_PRIVATE_KEY=                      # 仅测试网，绝不填主网

# 阶段 5：LLM-as-a-Judge 忠实度评判（默认关闭，开启后 --full 会多花约一倍的生成 token）
EVAL_LLM_JUDGE=false

# 高德 Web 端 JS Key（Track Studio / TrailShare embed 用；前端构建期注入）
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
