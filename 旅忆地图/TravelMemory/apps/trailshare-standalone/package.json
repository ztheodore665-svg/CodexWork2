{
  "name": "@travelmemory/trailshare-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrailShare 独立小应用：选照片 + 填旅程 → 打包成 .trailshare（零后端，全程零网络请求）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "@travelmemory/amap-loader": "*",
    "@travelmemory/geo": "*",
    "@travelmemory/journey-transfer": "*",
    "@travelmemory/photo-source": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
